**/.DS_Store
.DS_Store
# the file-graph scan output at the REPO ROOT only — anchored, or this would also
# ignore plugins/notrest/skills/graph/ (gitignore matches any depth otherwise)
/graph/
# F6: a scan run from inside the plugin wrote its output to plugins/notrest/graph/,
# which the root anchor above does NOT cover — 4 derived files, 125 KB, shipped to
# every consumer for five weeks referenced by nothing. Anchored per plugin dir, so
# plugins/*/skills/graph/ (the skill itself) stays tracked. doctor's GITIGNORE check
# now FAILS on tracked derived output here, so the rule cannot rot into a comment.
plugins/*/graph/
plugins/*/compile/candidates.*
plugins/*/compile/decisions.md
# compile.py's repeated-work scan output at the REPO ROOT only — derived, regenerated
# by every scan (same rationale as /graph/). Anchored, so the skill's own directory
# (plugins/notrest/skills/compile/) stays tracked.
# compile: derived scan output is ignored; hand-built compiled runtimes under
# compile/<slug>/ are SOURCE and must be tracked.
# fixture scratch trees are throwaway clones, never source
compile/*/.fixture-scratch/
/compile/candidates.md
/compile/candidates.json
/compile/decisions.md
/compile/.auto-build
# Run artifacts from the RETIRED external runner (`claude plugin eval --output-dir
# evals/results`). Kept ignored so any stray old artifacts stay out of the tree; the
# retired cases themselves live tracked at plugins/notrest/evals-legacy-external-runner/.
# The live gate is /eval (skills/eval/scripts/eval.py), which writes nothing here.
/evals/results/

# the pulse layer: machine-written instrument readings, refreshed in the background.
# Derived and disposable — the ledgers (COORD, COORD-AGENTS, spend) remain the record.
/pulse/

# 4.7.0: the daemon's DRAFTED scaffolds are the compile queue, not release content — a runtime enters git only when ADOPTED (git add -f compile/<slug>)
/compile/*/
!/compile/release-ritual/
/compile/.auto-run.lock

# 4.8.0: the atlas bank's derived outputs stay local; atlas/map.md and born-red.json are estate state and are tracked
/atlas/snapshots/
/atlas/board.json
